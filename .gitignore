# Specifications — source of truth for building this plugin, not published.
# Everything the plugin needs at runtime must be captured in skills/ and docs/.
specs/

# Scratch space for read-only exports pulled from live environments while
# developing. May contain real tenant/resource identifiers.
.scratch/

# Migration artifacts generated by the plugin. These describe a real customer's
# organization, quotas and members — never commit them.
migration/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Secrets — belt and braces. Nothing here should ever exist in this repo.
*.env
.env.*
*.pem
*.key
**/secrets.json
**/local.settings.json
